# 호구닷컴 환경변수 예시 - 복사해서 .env 로 사용하세요. (.env 는 git에 올리지 않습니다)

PORT=8090
SITE_ORIGIN=https://hogu.example.com
TRUST_PROXY=1
NODE_ENV=production

# ── 세션(JWT) ──────────────────────────────────────────
# 32바이트 이상 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
SESSION_COOKIE_NAME=hgdc_session

# ── AWS RDS MySQL ─────────────────────────────────────
HGDC_MYSQL_HOST=xxxx.ap-northeast-2.rds.amazonaws.com
HGDC_MYSQL_PORT=3306
HGDC_MYSQL_USER=
HGDC_MYSQL_PASSWORD=
HGDC_MYSQL_DATABASE=hgdc_DB
# RDS SSL 연결 사용 여부 (true 권장)
HGDC_MYSQL_SSL=true
# 서버 기동 시 테이블 자동 생성 (CREATE TABLE IF NOT EXISTS)
HGDC_DB_AUTO_MIGRATE=true

# 로컬 DB를 쓰고 싶을 때 (.env.local 에 넣는 것을 권장)
# HGDC_USE_LOCAL_DB=true
# HGDC_LOCAL_MYSQL_HOST=127.0.0.1
# HGDC_LOCAL_MYSQL_USER=root
# HGDC_LOCAL_MYSQL_PASSWORD=root
# HGDC_LOCAL_MYSQL_DATABASE=hgdc_DB_local

# ── KCP 본인확인 V2 ──────────────────────────────────
KCP_SITE_CODE=
KCP_ENC_KEY=
KCP_RETURN_URL=https://hogu.example.com/kcp/callback
# production | test | mock  (mock 은 NODE_ENV!=production 에서만 동작, 로컬 개발용 가짜 인증)
KCP_CERT_ENV=production
